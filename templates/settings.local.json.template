{
  "permissions": {
    "allow": [
      "Read(**/*)",
      "Edit(**/*)",
      "Write(**/*)",
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Glob(**/*)",
      "Grep(**/*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(chmod -R 777 /)"
    ]
  },
  "alwaysThinkingEnabled": true
}
